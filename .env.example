# ── Database (PostgreSQL) ────────────────────────────────────
# Local development: `npm run db:local` starts a Postgres with these values.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=habitflow

# A hosted database: set this ONE variable instead of the five above
# (`npm run db:setup:live` writes it for you).
# DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"   # only if the provider uses its own CA (Aiven does)
# DB_POOL_SIZE=3                                                               # connections per running copy of the app

# ── Session ──────────────────────────────────────────────────
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The site's public address. Not needed on Vercel. Set it on your own server:
# links in emails (password reset, unsubscribe) are built from it.
# APP_URL=https://habits.example.com

# Google Search Console → Add property → URL prefix → "HTML tag": paste only
# the code inside content="..." here to prove the site is yours.
# GOOGLE_SITE_VERIFICATION=

# ── Sign in with Google (optional) ───────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI:  https://YOUR-SITE/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Email (optional): forgot password, sign-up codes, Winter Arc reminders ──
# From https://resend.com → API Keys. EMAIL_FROM must be on a domain you have
# verified there (until then Resend only delivers to your own address).
# RESEND_API_KEY=
# EMAIL_FROM="HabitFlow <hello@yourdomain.com>"
# Any long random string; the same value goes in the GitHub secret CRON_SECRET
# (see .github/workflows/reminders.yml), which triggers the reminders.
# CRON_SECRET=

# ── Push notifications (optional): habit reminders, morning quote, evening nudge ──
# Make a pair once with `npm run push:keys` and keep them.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
