# ── Database (PostgreSQL) ────────────────────────────────────
# Local development: `npm run db:local` starts a Postgres with these values.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=habitflow

# A hosted database: set this ONE variable instead of the five above
# (`npm run db:setup:live` writes it for you).
# DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"   # only if the provider uses its own CA (Aiven does)
# DB_POOL_SIZE=3                                                               # connections per running copy of the app

# ── Session ──────────────────────────────────────────────────
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
