# ── Database (XAMPP MySQL/MariaDB defaults) ──────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=habitflow
# Hosted databases need an encrypted connection:
# DB_SSL=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"   # only if the provider uses its own CA (Aiven does)
# DB_POOL_SIZE=3                                                               # keep small on serverless hosts

# ── Session ──────────────────────────────────────────────────
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
